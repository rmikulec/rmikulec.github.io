# GitHub personal access token used at BUILD TIME only to read your repos
# (including private ones) and collect their .portfolio files.
#
# Scope needed: "repo" (classic) or "Contents: read-only" (fine-grained).
# Local dev: copy this file to .env.local and paste a token.
# CI: store as the GH_PORTFOLIO_TOKEN GitHub Actions secret instead (see README).
#
# Without a token the build still works but only sees PUBLIC repos.
GITHUB_TOKEN=

# GitHub username whose repos are scanned for .portfolio files.
GITHUB_USERNAME=rmikulec
