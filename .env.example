# GitHub personal access token(s) used at BUILD TIME only to read your repos
# (including private ones) and collect their .portfolio files.
#
# Scope: classic PAT with "repo" (+ "read:org") spans your account AND orgs —
# authorize it via SSO if an org requires it. A fine-grained token is scoped to
# ONE owner, so to also cover an org (e.g. ARRM-Studios) supply a SECOND token
# for that owner as a comma-separated list:
#     GH_PORTFOLIO_TOKEN=personalToken,orgToken
#
# Local dev: copy this file to .env.local and paste token(s).
# CI: store as the GH_PORTFOLIO_TOKEN GitHub Actions secret instead (see README).
#
# Without any token the build still works but only sees PUBLIC repos.
GH_PORTFOLIO_TOKEN=

# GitHub username whose PUBLIC repos are scanned when no token is provided.
GITHUB_USERNAME=rmikulec
